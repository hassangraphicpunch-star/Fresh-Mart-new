# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform API Keys
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# WhatsApp Business Cloud API Credentials (Server-Side Only)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_CUSTOMER_TEMPLATE_NAME="fresh_mart_order_confirmation"
WHATSAPP_OWNER_TEMPLATE_NAME="fresh_mart_owner_new_order"

# Optional comma-separated list of admin email addresses
ADMIN_EMAILS="hassangraphicpunch@gmail.com"
